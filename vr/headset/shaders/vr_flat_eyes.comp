#version 450
// (Hookshot VR, vr/headset/flat_eyes.inc) one eye's view of a flat frame: the world screen, fixed in the room, drawn as that
// eye sees it from its own pose and FOV (RX_VR_FLAT_LAYER=eyes). Also a gameplay picture for an eye turned from the head: the
// picture on a screen a metre ahead of the eye, as wide as its FOV (RX_VR_MONO_POSE=eyes).
//
// Each pixel's ray leaves the eye along its own view (its four FOV tangents, turned into the screen's axes by c0-c2); where
// it crosses the screen the picture is averaged over the pixel's footprint there, so a picture larger than it is seen does
// not shimmer as the head moves. The screen's edge is the pixel's coverage of it, over black; alpha 1 everywhere.
// Compile: glslangValidator -V --target-env vulkan1.3 --vn VR_FLAT_EYES_COMP_SPV -o vr_flat_eyes_comp_spv.h vr_flat_eyes.comp
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D eye_out;
layout(binding = 1) uniform sampler2D picture;

layout(push_constant) uniform Push {
    vec4 eye;        // xyz: the eye in the screen's coordinates (x right, y up, z toward the viewer, m)
    vec4 tangent;    // the eye's view: its left, right, bottom and top edges' tangents
    vec4 c0, c1, c2; // xyz: the eye's x, y and z axes in the screen's coordinates; c0.w, c1.w: this view's size in pixels
    vec4 half_size;  // xy: the screen's half width and half height (m); z: the fewest samples a pixel across (1 or 2)
} pc;

// Where the ray through a point of the view (pixels) meets the screen, 0..1 from its top left
bool hit(vec2 px, out vec2 uv)
{
    vec2 t = px / vec2(pc.c0.w, pc.c1.w);
    vec3 d = pc.c0.xyz * mix(pc.tangent.x, pc.tangent.y, t.x) + pc.c1.xyz * mix(pc.tangent.w, pc.tangent.z, t.y) - pc.c2.xyz;
    uv = vec2(-1.0);
    if (pc.eye.z <= 0.0 || d.z >= -1e-4) return false;
    vec2 xy = pc.eye.xy + d.xy * (pc.eye.z / -d.z);
    uv = vec2(0.5, 0.5) + vec2(0.5, -0.5) * xy / pc.half_size.xy;
    return true;
}

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.c0.w) || px.y >= int(pc.c1.w)) return;
    vec2 p = vec2(px) + 0.5, uv, ux, uy;
    vec3 c = vec3(0.0);
    if (hit(p, uv) && hit(p + vec2(1, 0), ux) && hit(p + vec2(0, 1), uy)) {
        vec2 jx = ux - uv, jy = uy - uv, wide = max(abs(jx) + abs(jy), vec2(1e-7));
        vec2 cover = clamp(min(uv, 1.0 - uv) / wide + 0.5, 0.0, 1.0);
        if (cover.x * cover.y > 0.0) {
            vec2 size = vec2(textureSize(picture, 0)), half_texel = 0.5 / size;
            // (a screen fixed in the room: at least two samples across, so it does not shimmer. A picture about a texel a
            // pixel, half_size.z 1, a turned eye's: one, as sharp as can be)
            float texels = max(length(jx * size), length(jy * size));
            int n = clamp(int(ceil(texels + (pc.half_size.z > 1.5 ? 0.5 : -0.3))), int(pc.half_size.z), 4);
            for (int j = 0; j < n; j++)
                for (int i = 0; i < n; i++) {
                    vec2 o = (vec2(i, j) + 0.5) / float(n) - 0.5;
                    c += textureLod(picture, clamp(uv + jx * o.x + jy * o.y, half_texel, 1.0 - half_texel), 0.0).rgb;
                }
            c *= cover.x * cover.y / float(n * n);
        }
    }
    imageStore(eye_out, px, vec4(c, 1.0));
}
